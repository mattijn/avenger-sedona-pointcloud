{
  "about": "The step vocabulary of experiment 7's pipeline, as data. Types are checked natively by each validator; `requires` is a CEL expression over the pipeline state before the step, `sets` updates that state (a `$name` value is taken from the step's argument `name`).",
  "types": {
    "text": "any string",
    "path": "any string",
    "hex": "#rrggbb",
    "unit": "a number in 0..1",
    "unit_pair": "two numbers in 0..1, `a,b`",
    "number": "a number",
    "range_pair": "two ranges, `a..b c..d`",
    "flag": "present or `true`/`false`",
    "channel": "`field` or `field:N|O|Q|T`; a `#rrggbb` is allowed where colour is",
    "vega": "a Vega expression",
    "sql": "a SQL query over `input`"
  },
  "state": {"phase": "start", "mark": ""},
  "steps": {
    "read":   {"kind": "source", "positional": [["path", "path"]], "flags": {"statistics": "flag"},
               "requires": "state.phase == 'start'", "sets": {"phase": "data"}},
    "filter": {"kind": "transform", "flags": {"vega": "vega", "sql": "text"},
               "requires": "state.phase == 'data'"},
    "calc":   {"kind": "transform", "positional": [["name", "text"]], "flags": {"vega": "vega", "sql": "text"},
               "requires": "state.phase == 'data'"},
    "sql":    {"kind": "transform", "positional": [["query", "sql"]],
               "requires": "state.phase == 'data'"},
    "head":   {"kind": "sink", "positional": [["n", "number"]], "requires": "state.phase != 'start'"},
    "chart":  {"kind": "command", "positional": [["mark", ["bar", "arc", "line", "rect", "point"]]],
               "flags": {"x": "channel", "y": "channel", "color": "channel", "theta": "channel", "detail": "channel"},
               "requires": "state.phase in ['data', 'chart']", "sets": {"phase": "chart", "mark": "$mark"}},
    "bars":   {"kind": "command", "positional": [["y", "channel"]], "flags": {"by": "channel"},
               "requires": "state.phase in ['data', 'chart']", "sets": {"phase": "chart", "mark": "bar"}},
    "pie":    {"kind": "command", "positional": [["theta", "channel"]], "flags": {"by": "channel"},
               "requires": "state.phase in ['data', 'chart']", "sets": {"phase": "chart", "mark": "arc"}},
    "line":   {"kind": "command", "positional": [["y", "channel"]], "flags": {"x": "channel", "series": "channel"},
               "requires": "state.phase in ['data', 'chart']", "sets": {"phase": "chart", "mark": "line"}},
    "heatmap":{"kind": "command", "positional": [["color", "channel"]], "flags": {"x": "channel", "y": "channel"},
               "requires": "state.phase in ['data', 'chart']", "sets": {"phase": "chart", "mark": "rect"}},
    "map":    {"kind": "command", "flags": {"x": "channel", "y": "channel", "value": "channel"},
               "requires": "state.phase in ['data', 'chart']", "sets": {"phase": "chart", "mark": "point"}},
    "title":  {"kind": "command", "positional": [["text", "text"]], "requires": "state.phase == 'chart'"},
    "set":    {"kind": "command", "positional": [["property", "text"], ["value", "text"]], "requires": "state.phase == 'chart'"},
    "color":  {"kind": "command", "positional": [["colour", "hex"]], "requires": "state.phase == 'chart'"},
    "zoom":   {"kind": "command", "positional": [["x", "text"], ["y", "text"]],
               "requires": "state.phase == 'chart' && state.mark != 'arc'"},
    "reset-zoom": {"kind": "command", "requires": "state.phase == 'chart'"},
    "highlight": {"kind": "command", "positional": [["where", "vega"]],
               "requires": "state.phase == 'chart' && state.mark in ['bar', 'arc', 'point']"},
    "clear-highlight": {"kind": "command", "requires": "state.phase == 'chart'"},
    "view":   {"kind": "command", "positional": [["kind", ["flat", "fisheye", "magnifier", "tilt"]]],
               "flags": {"focus": "unit_pair", "radius": "unit", "distortion": "number", "zoom": "number",
                         "yaw": "number", "elevation": "number", "offset": ["auto", "none"]},
               "requires": "state.phase == 'chart' && (step.kind != 'tilt' || state.mark == 'point')"},
    "lens":   {"kind": "command", "positional": [["kind", ["regression", "sample", "mole", "clear"]]],
               "flags": {"focus": "unit_pair", "radius": "unit", "keep": "unit", "above": "unit"},
               "requires": "state.phase == 'chart'"},
    "select": {"kind": "command", "positional": [["kind", ["point", "interval", "segment", "timebox", "lasso", "clear"]]],
               "flags": {"keys": "text", "effect": ["fade", "filter"], "soft": "unit", "structure": "unit",
                         "yaw": "number", "elevation": "number", "poly": "text", "x": "text", "y": "text"},
               "requires": "state.phase == 'chart'"}
  }
}
