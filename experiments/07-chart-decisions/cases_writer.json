{
  "note": "Phase H cases: Jev steers, a general model writes the pipeline. A start state, an instruction, and what the folded state must be. `v` cases are in the pilot's vocabulary (the options say it all); `w` cases need text of their own. Each has a reference: the data stages of a table (optionally edited) and the chart commands, run by writer_eval --check to prove the expectation is reachable. Written before any decider or writer ran.",
  "cases": [
    {"id": "v01", "start": {"mark": "bars"}, "text": "make the bars red",
     "expect": {"colour": "red"}, "reference": {"data": "classes", "commands": ["bars n --by label", "color #c44e52"]}},
    {"id": "v02", "start": {"mark": "bars"}, "text": "which share does each class have?",
     "expect": {"mark": "pie"}, "reference": {"data": "classes", "commands": ["pie n --by label"]}},
    {"id": "v03", "start": {"mark": "line"}, "text": "zoom in on the start of the lines, the top left",
     "expect": {"zoom": "north_west"}, "reference": {"data": "flight", "commands": ["line n --x t --series line", "zoom {nw}"]}},
    {"id": "v04", "start": {"mark": "map"}, "text": "mark the tallest buildings",
     "expect": {"highlight": true, "threshold": null}, "reference": {"data": "cells", "commands": ["map --x cx --y cy --value h", "highlight \"datum.h >= {top}\""]}},
    {"id": "v05", "start": {"mark": "map"}, "text": "kleur de gebouwen groen",
     "expect": {"colour": "green"}, "reference": {"data": "cells", "commands": ["map --x cx --y cy --value h", "color #59a14f"]}},
    {"id": "v06", "start": {"mark": "pie"}, "text": "nice, leave it like this",
     "expect": {"unchanged": true}, "reference": {"data": "classes", "commands": ["pie n --by label"]}},

    {"id": "w01", "start": {"mark": "map"}, "text": "call it Rooftops of the tile",
     "expect": {"mark": "map", "title": "Rooftops of the tile"}, "reference": {"data": "cells", "commands": ["map --x cx --y cy --value h", "title \"Rooftops of the tile\""]}},
    {"id": "w02", "start": {"mark": "bars"}, "text": "noem de grafiek Punten per klasse",
     "expect": {"mark": "bars", "title": "Punten per klasse"}, "reference": {"data": "classes", "commands": ["bars n --by label", "title \"Punten per klasse\""]}},
    {"id": "w03", "start": {"mark": "map"}, "text": "only emphasise buildings taller than 70 m",
     "expect": {"highlight": true, "threshold": 70}, "reference": {"data": "cells", "commands": ["map --x cx --y cy --value h", "highlight \"datum.h >= 70\""]}},
    {"id": "w04", "start": {"mark": "map"}, "text": "use 10 m cells instead of 5 m",
     "expect": {"mark": "map", "rows": 3489}, "reference": {"data": "cells", "replace": [["/5)*5", "/10)*10"]], "commands": ["map --x cx --y cy --value h"]}},
    {"id": "w05", "start": {"mark": "map"}, "text": "zoom to easting 657200 to 657600 and northing 6867300 to 6867700",
     "expect": {"range": [[657200, 657600], [6867300, 6867700]]}, "reference": {"data": "cells", "commands": ["map --x cx --y cy --value h", "zoom 657200..657600 6867300..6867700"]}},
    {"id": "w06", "start": {"mark": "line"}, "text": "zoom to the first 5 seconds",
     "expect": {"range_x": [0, 5]}, "reference": {"data": "flight", "commands": ["line n --x t --series line", "zoom 0..5 {y}"]}},
    {"id": "w07", "start": {"mark": "bars"}, "text": "make them orange and call it Point counts",
     "expect": {"colour": "orange", "title": "Point counts"}, "reference": {"data": "classes", "commands": ["bars n --by label", "title \"Point counts\"", "color #f28e2b"]}},
    {"id": "w08", "start": {"mark": "pie"}, "text": "back to bars in red, titled Classes",
     "expect": {"mark": "bars", "colour": "red", "title": "Classes"}, "reference": {"data": "classes", "commands": ["bars n --by label", "title \"Classes\"", "color #c44e52"]}},
    {"id": "w09", "start": {"mark": "map"}, "text": "colour the map green and emphasise everything above 60 m",
     "expect": {"colour": "green", "highlight": true, "threshold": 60}, "reference": {"data": "cells", "commands": ["map --x cx --y cy --value h", "color #59a14f", "highlight \"datum.h >= 60\""]}},
    {"id": "w10", "start": {"mark": "map"}, "text": "show the buildings in 2 m cells",
     "expect": {"mark": "map", "rows_gt": 11719}, "reference": {"data": "cells", "replace": [["/5)*5", "/2)*2"]], "commands": ["map --x cx --y cy --value h"]}},
    {"id": "w11", "start": {"mark": "map"}, "text": "zoom to the north-east and emphasise buildings over 65 m",
     "expect": {"zoom": "north_east", "highlight": true, "threshold": 65}, "reference": {"data": "cells", "commands": ["map --x cx --y cy --value h", "highlight \"datum.h >= 65\"", "zoom {ne}"]}},
    {"id": "w12", "start": {"mark": "map"}, "text": "draw the buildings as a 3D model",
     "expect": {"unchanged": true}, "reference": {"data": "cells", "commands": ["map --x cx --y cy --value h"]}},
    {"id": "w13", "start": {"mark": "heatmap"}, "text": "emphasise the band with the most points",
     "expect": {"unchanged": true}, "reference": {"data": "class_height", "commands": ["heatmap n --x band --y label"]}}
  ]
}
