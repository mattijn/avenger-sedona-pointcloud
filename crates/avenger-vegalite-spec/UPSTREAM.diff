+#[cfg(feature = "schema")]
+#[test]
+fn json_schema_carries_structure_ranges_and_rules() {
+    let schema = serde_json::to_value(avenger_vegalite_spec::schema::unit_spec_schema()).unwrap();
+    assert_eq!(
+        schema["$schema"],
+        "https://json-schema.org/draft/2020-12/schema"
+    );
+    assert_eq!(schema["additionalProperties"], false);
+    assert_eq!(schema["properties"]["width"]["minimum"], 0);
+    let bin = &schema["$defs"]["BinParams"];
+    assert_eq!(bin["properties"]["maxbins"]["minimum"], 2);
+    let rules: Vec<&str> = bin["x-avenger-rules"]
+        .as_array()
+        .unwrap()
+        .iter()
+        .map(|r| r["path"].as_str().unwrap())
+        .collect();
+    assert_eq!(rules, ["extent", "steps"]);
+    // Optional properties are not nullable; the nullable ones say so.
+    assert!(schema["properties"]["width"].get("anyOf").is_none());
+    assert_eq!(
+        schema["$defs"]["PositionFieldDef"]["properties"]["bin"]["anyOf"][1],
+        serde_json::json!({ "const": null })
+    );
+}
