diff -ruN -x LICENSE -x VENDORED.md -x UPSTREAM.diff -x target upstream/avenger-vegalite-spec/src/schema.rs avenger-vegalite-spec/src/schema.rs
--- upstream/avenger-vegalite-spec/src/schema.rs	1970-01-01 01:00:00
+++ avenger-vegalite-spec/src/schema.rs	2026-09-26 20:29:46
